#: er-librairie.php
msgid ""
"Les données de la librairie : auteurs et langues des livres, les rencontres "
"du centre et leur billetterie, et des traductions de secours pour "
"WooCommerce tant que son paquet de langue français n'est pas installé. "
"Séparée du thème : la direction artistique peut changer sans toucher aux "
"livres."
msgstr ""

