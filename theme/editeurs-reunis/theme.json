{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"custom": false,
			"customGradient": false,
			"palette": [
				{ "slug": "base", "name": "Fond", "color": "#FEFCF8" },
				{ "slug": "contrast", "name": "Encre", "color": "#1C1C1C" },
				{ "slug": "encre-2", "name": "Encre secondaire", "color": "#4A4A48" },
				{ "slug": "discret", "name": "Discret", "color": "#6B6B66" },
				{ "slug": "filet", "name": "Filet", "color": "#DBD9D4" },
				{ "slug": "doux", "name": "Fond doux", "color": "#F7F5F1" },
				{ "slug": "pierre", "name": "Pierre", "color": "#E7E4DD" },
				{ "slug": "accent", "name": "Pervenche", "color": "#9DB5F5" },
				{ "slug": "accent-pale", "name": "Pervenche pâle", "color": "#E4EBFD" },
				{ "slug": "accent-texte", "name": "Pervenche foncée (texte)", "color": "#4F6AD8" },
				{ "slug": "noir", "name": "Noir", "color": "#000000" },
				{ "slug": "aplat-nuit", "name": "Aplat nuit", "color": "#101642" },
				{ "slug": "aplat-vert", "name": "Aplat vert", "color": "#2F4943" },
				{ "slug": "aplat-brun", "name": "Aplat brun", "color": "#2C1F17" },
				{ "slug": "aplat-noir", "name": "Aplat noir", "color": "#26231F" },
				{ "slug": "papier-clair", "name": "Contenu · papier clair", "color": "#FBF8F1" },
				{ "slug": "papier", "name": "Contenu · papier", "color": "#F1E9DA" },
				{ "slug": "filet-papier", "name": "Contenu · filet papier", "color": "#DCD2C0" },
				{ "slug": "ocre", "name": "Contenu · ocre", "color": "#A87F32" },
				{ "slug": "reliure", "name": "Contenu · reliure", "color": "#6B2A27" },
				{ "slug": "rayonnage", "name": "Contenu · rayonnage", "color": "#23403D" },
				{ "slug": "cuir", "name": "Contenu · cuir", "color": "#7A5233" },
				{ "slug": "maison-librairie", "name": "Maison · librairie, vert rayonnage", "color": "#2F4943" },
				{ "slug": "maison-ymca", "name": "Maison · YMCA-Press, brun reliure", "color": "#553826" },
				{ "slug": "maison-centre", "name": "Maison · centre culturel, bleu nuit", "color": "#101642" },
				{ "slug": "point-librairie", "name": "Point · librairie, sur le noir", "color": "#5A9C8C" },
				{ "slug": "point-ymca", "name": "Point · YMCA-Press, sur le noir", "color": "#B8744A" },
				{ "slug": "point-centre", "name": "Point · centre culturel, sur le noir", "color": "#5465EA" },
				{ "slug": "teinte-librairie", "name": "Teinte · librairie, la bande de page", "color": "#E6F0EE" },
				{ "slug": "teinte-ymca", "name": "Teinte · YMCA-Press, la bande de page", "color": "#F4EAE4" },
				{ "slug": "teinte-centre", "name": "Teinte · centre culturel, la bande de page", "color": "#E5E8FC" }
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"customFontSize": false,
			"fluid": true,
			"fontFamilies": [
				{
					"slug": "montserrat",
					"name": "Montserrat",
					"fontFamily": "Montserrat, \"Helvetica Neue\", Arial, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Montserrat",
							"fontStyle": "normal",
							"fontWeight": "300 700",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/montserrat.woff2" ]
						},
						{
							"fontFamily": "Montserrat",
							"fontStyle": "italic",
							"fontWeight": "400 700",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/montserrat-italique.woff2" ]
						}
					]
				}
			],
			"fontSizes": [
				{ "slug": "x-small", "name": "Très petit", "size": "0.75rem", "fluid": false },
				{ "slug": "small", "name": "Petit", "size": "0.875rem", "fluid": false },
				{ "slug": "medium", "name": "Moyen", "size": "1.0625rem", "fluid": false },
				{ "slug": "large", "name": "Grand", "size": "1.375rem", "fluid": { "min": "1.25rem", "max": "1.5rem" } },
				{ "slug": "x-large", "name": "Très grand", "size": "2.25rem", "fluid": { "min": "1.75rem", "max": "2.5rem" } },
				{ "slug": "xx-large", "name": "Énorme", "size": "3.5rem", "fluid": { "min": "2.375rem", "max": "4.25rem" } }
			]
		},
		"spacing": {
			"defaultSpacingSizes": false,
			"units": [ "px", "rem", "%", "vw" ],
			"spacingSizes": [
				{ "slug": "20", "name": "Très petit", "size": "0.5rem" },
				{ "slug": "30", "name": "Petit", "size": "1rem" },
				{ "slug": "40", "name": "Moyen", "size": "1.5rem" },
				{ "slug": "50", "name": "Grand", "size": "clamp(2rem, 4vw, 3rem)" },
				{ "slug": "60", "name": "Très grand", "size": "clamp(3rem, 7vw, 5.5rem)" },
				{ "slug": "70", "name": "Énorme", "size": "clamp(4rem, 10vw, 8rem)" }
			]
		},
		"layout": {
			"contentSize": "760px",
			"wideSize": "100%"
		},
		"shadow": {
			"defaultPresets": false,
			"presets": [
				{ "slug": "livre", "name": "Livre", "shadow": "0 1px 2px rgba(0,0,0,.08), 0 10px 24px -8px rgba(0,0,0,.28)" }
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--base)",
			"text": "var(--wp--preset--color--contrast)"
		},
		"spacing": {
			"blockGap": "1.25rem",
			"padding": {
				"left": "clamp(1.25rem, 6vw, 5rem)",
				"right": "clamp(1.25rem, 6vw, 5rem)"
			}
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--montserrat)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"fontWeight": "400",
			"lineHeight": "1.6"
		},
		"elements": {
			"link": {
				"color": { "text": "currentColor" },
				"typography": { "textDecoration": "underline" },
				":hover": { "typography": { "textDecoration": "none" } }
			},
			"heading": {
				"color": { "text": "var(--wp--preset--color--contrast)" },
				"typography": { "fontWeight": "500", "lineHeight": "1.12", "letterSpacing": "-0.01em" }
			},
			"h1": { "typography": { "fontSize": "var(--wp--preset--font-size--xx-large)", "lineHeight": "1.02" } },
			"h2": { "typography": { "fontSize": "var(--wp--preset--font-size--x-large)" } },
			"h3": { "typography": { "fontSize": "var(--wp--preset--font-size--large)" } },
			"h4": { "typography": { "fontSize": "var(--wp--preset--font-size--medium)", "fontWeight": "600" } },
			"button": {
				"border": { "radius": "999px", "width": "1px", "style": "solid", "color": "var(--wp--preset--color--contrast)" },
				"color": { "background": "var(--wp--preset--color--contrast)", "text": "var(--wp--preset--color--base)" },
				"typography": { "fontSize": "var(--wp--preset--font-size--small)", "fontWeight": "500", "lineHeight": "1.2" },
				"spacing": { "padding": { "top": "0.7em", "bottom": "0.7em", "left": "1.5em", "right": "1.5em" } },
				":hover": { "color": { "background": "var(--wp--preset--color--encre-2)" } },
				":focus": { "outline": { "color": "var(--wp--preset--color--contrast)", "offset": "3px", "style": "solid", "width": "2px" } }
			},
			"caption": {
				"typography": { "fontSize": "var(--wp--preset--font-size--x-small)" },
				"color": { "text": "var(--wp--preset--color--discret)" }
			}
		},
		"blocks": {
			"core/navigation": {
				"typography": { "fontSize": "var(--wp--preset--font-size--small)", "fontWeight": "500" }
			},
			"core/post-title": {
				"typography": { "fontWeight": "500" }
			},
			"core/separator": {
				"color": { "text": "var(--wp--preset--color--filet)" }
			},
			"woocommerce/product-price": {
				"typography": { "fontWeight": "600" }
			}
		}
	},
	"templateParts": [
		{ "name": "header", "title": "En-tête", "area": "header" },
		{ "name": "header-essai", "title": "En-tête des pages d’essai", "area": "header" },
		{ "name": "footer", "title": "Pied de page", "area": "footer" }
	],
	"customTemplates": [
		{"name": "page-sans-titre", "title": "Page sans titre", "postTypes": ["page"]},
		{"name": "page-modules", "title": "Page en modules, pleine largeur", "postTypes": ["page"]},
		{"name": "page-texte", "title": "Page de texte : la tête calée sur le menu, puis les modules", "postTypes": ["page"]},
		{"name": "page-large", "title": "Page large (une liste : les événements)", "postTypes": ["page"]},
		{"name": "page-exemple", "title": "Page d’exemple (maquette)", "postTypes": ["page"]},
		{"name": "page-exemple-librairie", "title": "Page d’exemple (maquette), avec les rayons de la librairie", "postTypes": ["page"]},
		{"name": "page-essai", "title": "Page d’essai (l’en-tête épuré)", "postTypes": ["page"]}
	]
}
