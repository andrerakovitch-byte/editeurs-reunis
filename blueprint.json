{
	"$schema": "https://playground.wordpress.net/blueprint-schema.json",
	"meta": {
		"title": "Les Éditeurs réunis — ébauche du site",
		"description": "La librairie, YMCA-Press et le Centre culturel Alexandre Soljenitsyne : le thème, l'extension de la librairie et le contenu de l'ébauche.",
		"author": "andrerakovitch-byte"
	},
	"landingPage": "/",
	"preferredVersions": { "php": "8.3", "wp": "latest" },
	"features": { "networking": true },
	"login": true,
	"steps": [
		{ "step": "setSiteLanguage", "language": "fr_FR" },
		{
			"step": "installPlugin",
			"pluginData": { "resource": "wordpress.org/plugins", "slug": "woocommerce" },
			"options": { "activate": true }
		},
		{
			"step": "installTheme",
			"themeData": { "resource": "url", "url": "https://raw.githubusercontent.com/andrerakovitch-byte/editeurs-reunis/main/apercu/editeurs-reunis.zip" },
			"options": { "activate": true }
		},
		{
			"step": "installPlugin",
			"pluginData": { "resource": "url", "url": "https://raw.githubusercontent.com/andrerakovitch-byte/editeurs-reunis/main/apercu/er-librairie.zip" },
			"options": { "activate": true }
		},
		{
			"step": "runPHP",
			"code": "<?php require_once '/wordpress/wp-load.php'; require WP_PLUGIN_DIR . '/er-librairie/donnees/semer.php';"
		}
	]
}
